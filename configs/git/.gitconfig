# Identity is kept out of this PUBLIC repo. Put name/email in ~/.gitconfig.local
# (not tracked). See README / after-mac-install journal.
[include]
    path = ~/.gitconfig.local

[core]
    editor = vim
    autocrlf = input
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate -20
